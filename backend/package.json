    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "nodemon": "^2.0.22",
    "prisma": "^6.19.3",
    "prisma-erd-generator": "^2.4.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  }
