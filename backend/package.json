  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "lint": "eslint . --ext .ts",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts"
