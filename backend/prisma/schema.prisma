generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
  theme    = "forest"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  mcq
  canvas
  quantus
}

enum CanvasSubtype {
  drag_drop
  freeform
}

enum CellType {
  editable
  formula
  prefilled
  empty
  header
}

enum CellStyle {
  default
  yellow
  blue
  bold
  gray
  green
}

enum Difficulty {
  easy
  medium
  hard
}

enum LessonStatus {
  not_started
  in_progress
  completed
}

enum TopicType {
  topic
  drill
}

enum SessionStatus {
  active
  completed
  abandoned
}

enum PlanTier {
  free
  pro
  enterprise
}

model Module {
  id                   String               @id @default(uuid())
  slug                 String               @unique
  name                 String
  description          String?
  accentColor          String
  iconKey              String?
  orderIndex           Int                  @default(0)
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  topics               Topic[]
  userModuleProgresses UserModuleProgress[]
}

model Topic {
  id                  String               @id @default(uuid())
  moduleId            String
  module              Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name                String
  subtitle            String?
  description         String?
  tags                String[]             @default([])
  orderIndex          Int                  @default(0)
  type                TopicType            @default(topic)
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subtopics           Subtopic[]
  topicProfessionTags TopicProfessionTag[]
  userTopicProgresses UserTopicProgress[]
}

model Subtopic {
  id                   String               @id @default(uuid())
  topicId              String
  topic                Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  type                 TopicType            @default(topic)
  thumbnailUrl         String?
  orderIndex           Int                  @default(0)
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lessons              Lesson[]
  userSubtopicProgresses UserSubtopicProgress[]
}

model Lesson {
  id                   String               @id @default(uuid())
  subtopicId           String
  subtopic             Subtopic             @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  difficulty           Difficulty           @default(easy)
  orderIndex           Int                  @default(0)
  estimatedMins        Int?
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lessonActivities     LessonActivity[]
  mcqActivity          McqActivity?
  canvasActivity       CanvasActivity?
  quantusActivity      QuantusActivity?
  userLessonProgresses UserLessonProgress[]
  userLessonSessions   UserLessonSession[]
  skillBundleItems     SkillBundleItem[]
}

model LessonActivity {
  id           String       @id @default(uuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityType ActivityType
  orderIndex   Int          @default(0)

  @@unique([lessonId, activityType], map: "uq_lesson_act")
}

model McqActivity {
  id           String           @id @default(uuid())
  lessonId     String           @unique
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String?
  instructions String
  context      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  questions    McqQuestion[]
  sessions     UserMcqSession[]
}

model McqQuestion {
  id             String          @id @default(uuid())
  activityId     String
  activity       McqActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionText   String
  explanation    String
  orderIndex     Int             @default(0)
  createdAt      DateTime        @default(now())
  options        McqOption[]
  userMcqAnswers UserMcqAnswer[]
}

model McqOption {
  id             String          @id @default(uuid())
  questionId     String
  question       McqQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText     String
  isCorrect      Boolean         @default(false)
  orderIndex     Int             @default(0)
  createdAt      DateTime        @default(now())
  userMcqAnswers UserMcqAnswer[]

  @@index([questionId], map: "idx_mcq_options_question")
}

model QuantusActivity {
  id           String               @id @default(uuid())
  lessonId     String               @unique
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  context      String?
  referenceUrl String?
  createdAt    DateTime             @default(now())
  columnGroups QuantusColumnGroup[]
  columns      QuantusColumn[]
  sections     QuantusSection[]
  sessions     UserQuantusSession[]
}

model QuantusColumnGroup {
  id         String          @id @default(uuid())
  activityId String
  activity   QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  colStart   Int
  colEnd     Int
  bgColor    String          @default("#e8e8ff")
  textColor  String          @default("#333")
  orderIndex Int             @default(0)
}

model QuantusColumn {
  id           String          @id @default(uuid())
  activityId   String
  activity     QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label        String
  colIndex     Int
  widthPx      Int           @default(100)
  quantusCells QuantusCell[]

  @@unique([activityId, colIndex], map: "uq_quantus_col_index")
}

model QuantusSection {
  id          String          @id @default(uuid())
  activityId  String
  activity    QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label       String
  headerBg    String          @default("#6b5ce7")
  headerColor String          @default("#ffffff")
  orderIndex  Int             @default(0)
  rows        QuantusRow[]
}

model QuantusRow {
  id           String         @id @default(uuid())
  sectionId    String
  section      QuantusSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label        String
  rowKey       String
  isSeparator  Boolean        @default(false)
  isBold       Boolean        @default(false)
  isItalic     Boolean        @default(false)
  indentLevel  Int            @default(0)
  orderIndex   Int            @default(0)
  quantusCells QuantusCell[]

  @@unique([sectionId, rowKey], map: "uq_quantus_row_key")
}

model QuantusCell {
  id                String        @id @default(uuid())
  rowId             String
  row               QuantusRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  columnId          String
  column            QuantusColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  cellType          CellType      @default(empty)
  defaultValue      Float?
  formulaExpression String?
  styleClass        CellStyle     @default(default)
  prefix            String?
  decimalPlaces     Int           @default(2)
  isNegativeRed     Boolean       @default(true)

  @@unique([rowId, columnId], map: "uq_quantus_cell")
}

model CanvasActivity {
  id            String              @id @default(uuid())
  lessonId      String              @unique
  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  instructions  String
  context       String?
  subtype       CanvasSubtype       @default(drag_drop)
  drawingPrompt String?
  createdAt     DateTime            @default(now())
  zones         CanvasZone[]
  items         CanvasItem[]
  sessions      UserCanvasSession[]
}

model CanvasZone {
  id                   String                @id @default(uuid())
  activityId           String
  activity             CanvasActivity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  zoneKey              String
  label                String
  description          String?
  color                String
  bgColor              String
  orderIndex           Int                   @default(0)
  canvasItems          CanvasItem[]
  userCanvasPlacements UserCanvasPlacement[]

  @@unique([activityId, zoneKey], map: "uq_canvas_zone_key")
}

model CanvasItem {
  id                   String                @id @default(uuid())
  activityId           String
  activity             CanvasActivity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label                String
  description          String?
  correctZoneId        String?
  correctZone          CanvasZone?           @relation(fields: [correctZoneId], references: [id])
  orderIndex           Int                   @default(0)
  userCanvasPlacements UserCanvasPlacement[]
}

model ActivityHint {
  id             String          @id @default(uuid())
  activityType   ActivityType
  activityId     String
  hintText       String
  orderIndex     Int
  createdAt      DateTime        @default(now())
  userHintUsages UserHintUsage[]

  @@unique([activityId, activityType, orderIndex], map: "uq_hint_order")
  @@index([activityId], map: "idx_activity_hint_activity")
}

model User {
  id                        String                    @id @default(uuid())
  email                     String                    @unique
  name                      String?
  passwordHash              String
  role                      String                    @default("learner")
  planType                  PlanTier                  @default(free)
  avatarUrl                 String?
  timezone                  String?
  createdAt                 DateTime                  @default(now())
  lastActive                DateTime?
  deletedAt                 DateTime?
  userLessonProgresses      UserLessonProgress[]
  userSubtopicProgresses    UserSubtopicProgress[]
  userTopicProgresses       UserTopicProgress[]
  userModuleProgresses      UserModuleProgress[]
  userLessonSessions        UserLessonSession[]
  userActivityDrafts        UserActivityDraft[]
  mcqSessions               UserMcqSession[]
  canvasSessions            UserCanvasSession[]
  quantusSessions           UserQuantusSession[]
  hintUsage                 UserHintUsage[]
  userSkillBundleProgresses UserSkillBundleProgress[]
  userSkillItemProgresses   UserSkillItemProgress[]
}

model UserLessonProgress {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonCompletionPct Float        @default(0)
  mcqBestScore        Float?
  canvasBestScore     Float?
  quantusAttempted    Boolean      @default(false)
  status              LessonStatus @default(not_started)
  hintsUsed           Int          @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime     @default(now())

  @@unique([userId, lessonId], map: "uq_ulp")
}

model UserSubtopicProgress {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopicId           String
  subtopic             Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  subtopicCompletionPct Float   @default(0)
  recallStrength       Float    @default(0)
  conceptAccuracy      Float    @default(0)
  applicationScore     Float    @default(0)
  lessonsCompleted     Int      @default(0)
  lessonsTotal         Int      @default(0)
  updatedAt            DateTime @default(now())

  @@unique([userId, subtopicId], map: "uq_usp")
}

model UserTopicProgress {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicCompletionPct Float    @default(0)
  recallStrength     Float    @default(0)
  conceptAccuracy    Float    @default(0)
  applicationScore   Float    @default(0)
  lessonsCompleted   Int      @default(0)
  lessonsTotal       Int      @default(0)
  subtopicsCompleted Int      @default(0)
  subtopicsTotal     Int      @default(0)
  lastAccessedAt     DateTime?
  updatedAt          DateTime @default(now())

  @@unique([userId, topicId], map: "uq_utp")
}

model UserModuleProgress {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId            String
  module              Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleCompletionPct Float    @default(0)
  recallStrength      Float    @default(0)
  conceptAccuracy     Float    @default(0)
  applicationScore    Float    @default(0)
  topicsStarted       Int      @default(0)
  topicsTotal         Int      @default(0)
  lessonsCompleted    Int      @default(0)
  lessonsTotal        Int      @default(0)
  updatedAt           DateTime @default(now())

  @@unique([userId, moduleId], map: "uq_ump")
}

model UserLessonSession {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status             SessionStatus @default(active)
  currentActivityType ActivityType
  lastActiveAt       DateTime      @default(now())
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
  updatedAt          DateTime      @default(now())

  @@unique([userId, lessonId], map: "uq_user_lesson_session")
}

model UserActivityDraft {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activityType  ActivityType
  draftState    Json
  hintsRevealed Int          @default(0)
  startedAt     DateTime     @default(now())
  lastSavedAt   DateTime     @default(now())

  @@unique([userId, activityId, activityType], map: "uq_draft")
}

model UserMcqSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    McqActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  scorePct    Float?
  hintsUsed   Int             @default(0)
  completedAt DateTime        @default(now())
  answers     UserMcqAnswer[]
}

model UserMcqAnswer {
  id               String         @id @default(uuid())
  sessionId        String
  session          UserMcqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         McqQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   McqOption      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  isCorrect        Boolean
}

model UserCanvasSession {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    CanvasActivity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  score       Int?
  total       Int?
  scorePct    Float?
  canvasData  Json?
  hintsUsed   Int                   @default(0)
  completedAt DateTime              @default(now())
  placements  UserCanvasPlacement[]
}

model UserCanvasPlacement {
  id           String            @id @default(uuid())
  sessionId    String
  session      UserCanvasSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId       String
  item         CanvasItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  placedZoneId String
  placedZone   CanvasZone        @relation(fields: [placedZoneId], references: [id], onDelete: Cascade)
  isCorrect    Boolean
}

model UserQuantusSession {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activity      QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inputSnapshot Json
  score         Int             @default(0)
  total         Int             @default(0)
  scorePct      Float?
  hintsUsed     Int             @default(0)
  completedAt   DateTime        @default(now())
}

model UserHintUsage {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintId     String
  hint       ActivityHint @relation(fields: [hintId], references: [id], onDelete: Cascade)
  revealedAt DateTime     @default(now())
}

model SkillSection {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  description  String?
  activityType ActivityType?
  iconKey      String?
  orderIndex   Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  bundles      SkillBundle[]
}

model Profession {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  name        String                 @unique
  description String?
  iconKey     String?
  orderIndex  Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now())
  bundleLinks SkillBundleProfession[]
  topicTags   TopicProfessionTag[]
}

model SkillBundle {
  id             String                 @id @default(uuid())
  sectionId      String
  section        SkillSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  level          String
  durationWeeks  Float
  bundleGroup    String                 @default("profession_based")
  orderIndex     Int                    @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now())
  professions    SkillBundleProfession[]
  items          SkillBundleItem[]
  userProgresses UserSkillBundleProgress[]
}

model SkillBundleProfession {
  id            String      @id @default(uuid())
  bundleId      String
  bundle        SkillBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  professionId  String
  profession    Profession  @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([bundleId, professionId], map: "uq_bundle_profession")
}

model SkillBundleItem {
  id          String       @id @default(uuid())
  bundleId    String
  bundle      SkillBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityType      ActivityType
  label             String
  description       String?
  orderIndex        Int                    @default(0)
  userItemProgresses UserSkillItemProgress[]

  @@unique([bundleId, lessonId, activityType], map: "uq_bundle_item")
}

model UserSkillBundleProgress {
  id                String                @id @default(uuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundleId          String
  bundle            SkillBundle           @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  itemsCompleted    Int                   @default(0)
  itemsTotal        Int                   @default(0)
  completionPct     Float                 @default(0)
  recallStrength    Float                 @default(0)
  conceptAccuracy   Float                 @default(0)
  applicationScore  Float                 @default(0)
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  lastAccessedAt    DateTime              @default(now())
  updatedAt         DateTime              @default(now())

  @@unique([userId, bundleId], map: "uq_user_bundle_progress")
}

model UserSkillItemProgress {
  id            String                   @id @default(uuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundleItemId  String
  bundleItem    SkillBundleItem          @relation(fields: [bundleItemId], references: [id], onDelete: Cascade)
  bestScorePct  Float?
  isCompleted   Boolean                  @default(false)
  hintsUsed     Int                      @default(0)
  attempts      Int                      @default(0)
  completedAt   DateTime?
  updatedAt     DateTime                 @default(now())

  @@unique([userId, bundleItemId], map: "uq_user_skill_item")
}

model TopicProfessionTag {
  id           String      @id @default(uuid())
  topicId      String
  topic        Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  professionId String
  profession   Profession  @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([topicId, professionId], map: "uq_topic_profession")
}
