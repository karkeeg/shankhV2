generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LevelDifficulty {
  easy
  medium
  hard
}

enum ActivityType {
  mcq
  spreadsheet
  canvas
  decision
  lesson
  aiPack
  basic_input
}

enum AttemptStatus {
  in_progress
  submitted
  graded
}

enum UserRole {
  user
  admin
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(user)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  attempts     Attempt[]
  progress     Progress[]
}

model StudyPlan {
  id          String   @id @default(cuid())
  title       String
  description String?
  position    Int      @default(0)
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ModuleStage {
  foundation
  applied
  integrated
}

model Module {
  id              String      @id @default(cuid())
  studyPlanId     String
  title           String
  description     String?
  stage           ModuleStage @default(foundation)
  skillTags       String[]    @default([])
  learningObjective String?
  caseContext       String?
  importableCount Int         @default(0)
  position        Int         @default(0)
  studyPlan       StudyPlan   @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  topics          Topic[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Topic {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String?
  position    Int      @default(0)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  levels      Level[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Level {
  id          String          @id @default(cuid())
  topicId     String
  difficulty  LevelDifficulty
  title       String
  description String?
  position    Int             @default(0)
  topic       Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  activities  Activity[]
  progress    Progress[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Activity {
  id              String            @id @default(cuid())
  levelId         String
  title           String
  instructions    String?
  type            ActivityType
  position        Int               @default(0)
  level           Level             @relation(fields: [levelId], references: [id], onDelete: Cascade)
  versions        ActivityVersion[]
  attempts        Attempt[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ActivityVersion {
  id                  String   @id @default(cuid())
  activityId          String
  version             Int
  contentJson         Json
  validationRulesJson Json
  isPublished         Boolean  @default(false)
  activity            Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  attempts            Attempt[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([activityId, version])
}

model Attempt {
  id                String          @id @default(cuid())
  userId            String
  activityId        String
  activityVersionId String
  status            AttemptStatus   @default(in_progress)
  scorePercent      Float?
  checkCount        Int             @default(0)
  hintsUsedCount    Int             @default(0)
  startedAt         DateTime        @default(now())
  submittedAt       DateTime?
  gradedAt          DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity          Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Restrict)
  answers           AttemptAnswer[]
  result            AttemptResult?
}

model AttemptAnswer {
  id        String   @id @default(cuid())
  attemptId String
  payload   Json
  createdAt DateTime @default(now())
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AttemptResult {
  id                String   @id @default(cuid())
  attemptId         String   @unique
  validationSummary Json
  fieldFeedback     Json
  createdAt         DateTime @default(now())
  attempt           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  levelId        String
  completedCount Int      @default(0)
  avgScore       Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}
