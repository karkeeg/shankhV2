generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
  theme    = "forest"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  mcq
  canvas
  quantus
}

enum CanvasSubtype {
  drag_drop
  freeform
}

// ── NEW: Canvas redesign enums ───────────────────────────────────────────────
enum AssemblyMode {
  sequence // user orders tokens left-to-right; adjacency edges auto-inferred
  graph // user draws arrows between dropped tokens explicitly
}

enum ScoringMode {
  partial // credit per matched edge, penalty for extras/distractors
  exact // all-or-nothing: every edge must match, no extras
}

enum CellType {
  editable
  formula
  prefilled
  empty
  header
}

enum CellStyle {
  default
  yellow
  blue
  bold
  gray
  green
}

enum Difficulty {
  easy
  medium
  hard
}

enum LessonStatus {
  not_started
  in_progress
  completed
}

enum TopicType {
  topic
  drill
}

enum SessionStatus {
  active
  completed
  abandoned
}

enum PlanTier {
  free
  pro
  enterprise
}

model Module {
  id                   String               @id @default(uuid())
  slug                 String               @unique
  name                 String
  description          String?
  accentColor          String
  iconKey              String?
  orderIndex           Int                  @default(0)
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  topics               Topic[]
  userModuleProgresses UserModuleProgress[]
}

model Topic {
  id                  String              @id @default(uuid())
  moduleId            String
  module              Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name                String
  subtitle            String?
  description         String?
  // ── Skill Building display fields ──────────────────────────────────────────
  level               String? // e.g. "Beginners / Intermediate"
  durationWeeks       Decimal?            @db.Decimal(4, 1)
  // ────────────────────────────────────────────────────────────────────────────
  tags                String[]            @default([])
  orderIndex          Int                 @default(0)
  type                TopicType           @default(topic)
  isActive            Boolean             @default(true)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  subtopics           Subtopic[]
  userTopicProgresses UserTopicProgress[]
}

model Subtopic {
  id                     String                  @id @default(uuid())
  topicId                String
  topic                  Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  type                   TopicType               @default(topic)
  thumbnailUrl           String?
  orderIndex             Int                     @default(0)
  isActive               Boolean                 @default(true)
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lessons                Lesson[]
  subtopicProfessionTags SubtopicProfessionTag[]
  userSubtopicProgresses UserSubtopicProgress[]
}

model Lesson {
  id                   String               @id @default(uuid())
  subtopicId           String
  subtopic             Subtopic             @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  difficulty           Difficulty           @default(easy)
  orderIndex           Int                  @default(0)
  estimatedMins        Int?
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lessonActivities     LessonActivity[]
  mcqActivity          McqActivity?
  canvasActivity       CanvasActivity?
  quantusActivity      QuantusActivity?
  userLessonProgresses UserLessonProgress[]
  userLessonSessions   UserLessonSession[]
  skillBundleItems     SkillBundleItem[]
  skillLessons         SkillLesson[]
}

model LessonActivity {
  id           String       @id @default(uuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityType ActivityType
  orderIndex   Int          @default(0)

  @@unique([lessonId, activityType], map: "uq_lesson_act")
}

model McqActivity {
  id            String            @id @default(uuid())
  lessonId      String            @unique
  lesson        Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String?
  instructions  String
  context       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  questions     McqQuestion[]
  sessions      UserMcqSession[]
  skillSessions SkillMcqSession[]
}

model McqQuestion {
  id              String           @id @default(uuid())
  activityId      String
  activity        McqActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionText    String
  explanation     String
  orderIndex      Int              @default(0)
  createdAt       DateTime         @default(now())
  options         McqOption[]
  userMcqAnswers  UserMcqAnswer[]
  skillMcqAnswers SkillMcqAnswer[]
}

model McqOption {
  id              String           @id @default(uuid())
  questionId      String
  question        McqQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText      String
  isCorrect       Boolean          @default(false)
  orderIndex      Int              @default(0)
  createdAt       DateTime         @default(now())
  userMcqAnswers  UserMcqAnswer[]
  skillMcqAnswers SkillMcqAnswer[]

  @@index([questionId], map: "idx_mcq_options_question")
}

model QuantusActivity {
  id            String                @id @default(uuid())
  lessonId      String                @unique
  lesson        Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  instructions  String
  context       String?
  referenceUrl  String?
  createdAt     DateTime              @default(now())
  columnGroups  QuantusColumnGroup[]
  columns       QuantusColumn[]
  quantusCells  QuantusCell[]
  sessions      UserQuantusSession[]
  skillSessions SkillQuantusSession[]
}

model QuantusColumnGroup {
  id         String          @id @default(uuid())
  activityId String
  activity   QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  colStart   Int
  colEnd     Int
  bgColor    String          @default("#e8e8ff")
  textColor  String          @default("#333")
  orderIndex Int             @default(0)
}

model QuantusColumn {
  id         String          @id @default(uuid())
  activityId String
  activity   QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  colIndex   Int
  widthPx    Int             @default(100)

  @@unique([activityId, colIndex], map: "uq_quantus_col_index")
}

model QuantusCell {
  id            String          @id @default(uuid())
  activityId    String
  activity      QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  rowIndex      Int
  colIndex      Int
  cellType      String
  displayValue  String?
  expectedValue String?
  formula       String?
  formatType    String?
  isEditable    Boolean         @default(false)
  tolerancePct  Float?
  hintText      String?
  rowSpan       Int?            @default(1)
  colSpan       Int?            @default(1)

  @@unique([activityId, rowIndex, colIndex], map: "uq_quantus_cell")
}

// ═══════════════════════════════════════════════════════════════════════════
// CANVAS — token-edge graph model (REDESIGNED)
// Position on the canvas is purely cosmetic and is NOT stored in the solution.
// The "correct answer" is a set of slot-aware directed edges between tokens.
// Validation is a structural set-comparison done SERVER-SIDE.
// (Replaces the old CanvasPaletteItem / CanvasSolutionNode coordinate model.)
// ═══════════════════════════════════════════════════════════════════════════

model CanvasActivity {
  id            String               @id @default(uuid())
  lessonId      String               @unique
  lesson        Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  instructions  String
  context       String?
  assemblyMode  AssemblyMode         @default(graph)
  scoringMode   ScoringMode          @default(partial)
  // penaltyWeight applied to extra/distractor edges in partial scoring.
  // score = clamp(0,1, |matched|/|correct| - penaltyWeight*|extra|/|correct|)*100
  penaltyWeight Float                @default(0.5)
  passThreshold Float                @default(70) // % needed to mark complete
  createdAt     DateTime             @default(now())
  tokens        CanvasToken[]
  solutionEdges CanvasSolutionEdge[]
  sessions      UserCanvasSession[]
  skillSessions SkillCanvasSession[]
}

// Sidebar tokens — the single source of draggable pieces.
model CanvasToken {
  id           String               @id @default(uuid())
  activityId   String
  activity     CanvasActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  displayText  String // "Revenue", "−", "Gross Profit", "="
  tokenRole    String // operand | operator | relation | result
  shape        String               @default("rect") // rect | diamond | ellipse | pill
  isDistractor Boolean              @default(false) // appears in sidebar, in NO correct edge
  orderIndex   Int                  @default(0)
  edgesFrom    CanvasSolutionEdge[] @relation("TokenEdgesFrom")
  edgesTo      CanvasSolutionEdge[] @relation("TokenEdgesTo")
}

// Solution edges — token-to-token, slot-aware.
model CanvasSolutionEdge {
  id            String         @id @default(uuid())
  activityId    String
  activity      CanvasActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fromTokenId   String
  fromToken     CanvasToken    @relation("TokenEdgesFrom", fields: [fromTokenId], references: [id], onDelete: Cascade)
  toTokenId     String
  toToken       CanvasToken    @relation("TokenEdgesTo", fields: [toTokenId], references: [id], onDelete: Cascade)
  operandSlot   String? // left | right (null for un-slotted relations)
  isCommutative Boolean        @default(false) // accept either operand order on this edge
  edgeRole      String // sequence | connection
  edgeOrder     Int? // position in sequence mode; null for free graph edges
  edgeLabel     String?

  @@index([activityId], map: "idx_canvas_edge_activity")
}

model ActivityHint {
  id             String          @id @default(uuid())
  activityType   ActivityType
  activityId     String
  hintText       String
  orderIndex     Int
  createdAt      DateTime        @default(now())
  userHintUsages UserHintUsage[]

  @@unique([activityId, activityType, orderIndex], map: "uq_hint_order")
  @@index([activityId], map: "idx_activity_hint_activity")
}

model User {
  id                        String                    @id @default(uuid())
  email                     String                    @unique
  name                      String?
  passwordHash              String
  role                      String                    @default("learner")
  planType                  PlanTier                  @default(free)
  avatarUrl                 String?
  timezone                  String?
  createdAt                 DateTime                  @default(now())
  lastActive                DateTime?
  deletedAt                 DateTime?
  userLessonProgresses      UserLessonProgress[]
  userSubtopicProgresses    UserSubtopicProgress[]
  userTopicProgresses       UserTopicProgress[]
  userModuleProgresses      UserModuleProgress[]
  userLessonSessions        UserLessonSession[]
  userActivityDrafts        UserActivityDraft[]
  mcqSessions               UserMcqSession[]
  canvasSessions            UserCanvasSession[]
  quantusSessions           UserQuantusSession[]
  hintUsage                 UserHintUsage[]
  userSkillBundleProgresses UserSkillBundleProgress[]
  userSkillItemProgresses   UserSkillItemProgress[]
  userSkillTopicProgresses  UserSkillTopicProgress[]
  skillMcqSessions          SkillMcqSession[]
  skillCanvasSessions       SkillCanvasSession[]
  skillQuantusSessions      SkillQuantusSession[]
  userSkillLessonProgresses UserSkillLessonProgress[]
  userStreaks               UserStreak[]
}

model UserLessonProgress {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonCompletionPct Float        @default(0)
  mcqBestScore        Float?
  canvasBestScore     Float?
  quantusAttempted    Boolean      @default(false)
  status              LessonStatus @default(not_started)
  hintsUsed           Int          @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime     @default(now())

  @@unique([userId, lessonId], map: "uq_ulp")
}

model UserSubtopicProgress {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopicId            String
  subtopic              Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  subtopicCompletionPct Float    @default(0)
  recallStrength        Float    @default(0)
  conceptAccuracy       Float    @default(0)
  applicationScore      Float    @default(0)
  lessonsCompleted      Int      @default(0)
  lessonsTotal          Int      @default(0)
  updatedAt             DateTime @default(now())

  @@unique([userId, subtopicId], map: "uq_usp")
}

model UserTopicProgress {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicCompletionPct Float     @default(0)
  recallStrength     Float     @default(0)
  conceptAccuracy    Float     @default(0)
  applicationScore   Float     @default(0)
  lessonsCompleted   Int       @default(0)
  lessonsTotal       Int       @default(0)
  subtopicsCompleted Int       @default(0)
  subtopicsTotal     Int       @default(0)
  lastAccessedAt     DateTime?
  updatedAt          DateTime  @default(now())

  @@unique([userId, topicId], map: "uq_utp")
}

model UserModuleProgress {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId            String
  module              Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleCompletionPct Float    @default(0)
  recallStrength      Float    @default(0)
  conceptAccuracy     Float    @default(0)
  applicationScore    Float    @default(0)
  topicsStarted       Int      @default(0)
  topicsTotal         Int      @default(0)
  lessonsCompleted    Int      @default(0)
  lessonsTotal        Int      @default(0)
  updatedAt           DateTime @default(now())

  @@unique([userId, moduleId], map: "uq_ump")
}

model UserLessonSession {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status              SessionStatus @default(active)
  currentActivityType ActivityType
  activityOrder       Json?
  lastActiveAt        DateTime      @default(now())
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  updatedAt           DateTime      @default(now())

  @@unique([userId, lessonId], map: "uq_user_lesson_session")
}

model UserActivityDraft {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activityType  ActivityType
  draftState    Json
  hintsRevealed Int          @default(0)
  startedAt     DateTime     @default(now())
  lastSavedAt   DateTime     @default(now())

  @@unique([userId, activityId, activityType], map: "uq_draft")
}

model UserMcqSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    McqActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  scorePct    Float?
  hintsUsed   Int             @default(0)
  completedAt DateTime        @default(now())
  answers     UserMcqAnswer[]
}

model UserMcqAnswer {
  id               String         @id @default(uuid())
  sessionId        String
  session          UserMcqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         McqQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   McqOption      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  isCorrect        Boolean
}

model UserCanvasSession {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    CanvasActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  score       Int?
  total       Int?
  scorePct    Float?
  canvasData  Json?
  hintsUsed   Int            @default(0)
  completedAt DateTime       @default(now())
}

model UserQuantusSession {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activity      QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inputSnapshot Json
  score         Int             @default(0)
  total         Int             @default(0)
  scorePct      Float?
  hintsUsed     Int             @default(0)
  completedAt   DateTime        @default(now())
}

model UserHintUsage {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintId     String
  hint       ActivityHint @relation(fields: [hintId], references: [id], onDelete: Cascade)
  revealedAt DateTime     @default(now())
}

// ─── SKILL BUILDING ──────────────────────────────────────────────────────────

model SkillSection {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  description  String?
  activityType ActivityType?
  tabLabel     String?
  iconKey      String?
  orderIndex   Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  bundles      SkillBundle[]
}

model Profession {
  id           String                  @id @default(uuid())
  slug         String                  @unique
  name         String                  @unique
  description  String?
  iconKey      String?
  orderIndex   Int                     @default(0)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now())
  bundleLinks  SkillBundleProfession[]
  subtopicTags SubtopicProfessionTag[]
  skillTopics  SkillTopic[]
}

// Legacy bundle tables — kept in DB, no longer written to by new code
model SkillBundle {
  id             String                    @id @default(uuid())
  sectionId      String
  section        SkillSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  level          String
  durationWeeks  Float
  bundleGroup    String                    @default("profession_based")
  orderIndex     Int                       @default(0)
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @default(now())
  professions    SkillBundleProfession[]
  items          SkillBundleItem[]
  userProgresses UserSkillBundleProgress[]
}

model SkillBundleProfession {
  id           String      @id @default(uuid())
  bundleId     String
  bundle       SkillBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  professionId String
  profession   Profession  @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([bundleId, professionId], map: "uq_bundle_profession")
}

model SkillBundleItem {
  id                 String                  @id @default(uuid())
  bundleId           String
  bundle             SkillBundle             @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityType       ActivityType
  label              String
  description        String?
  orderIndex         Int                     @default(0)
  userItemProgresses UserSkillItemProgress[]

  @@unique([bundleId, lessonId, activityType], map: "uq_bundle_item")
}

model UserSkillBundleProgress {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundleId         String
  bundle           SkillBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  itemsCompleted   Int         @default(0)
  itemsTotal       Int         @default(0)
  completionPct    Float       @default(0)
  recallStrength   Float       @default(0)
  conceptAccuracy  Float       @default(0)
  applicationScore Float       @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  lastAccessedAt   DateTime    @default(now())
  updatedAt        DateTime    @default(now())

  @@unique([userId, bundleId], map: "uq_user_bundle_progress")
}

model UserSkillItemProgress {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundleItemId String
  bundleItem   SkillBundleItem @relation(fields: [bundleItemId], references: [id], onDelete: Cascade)
  bestScorePct Float?
  isCompleted  Boolean         @default(false)
  hintsUsed    Int             @default(0)
  attempts     Int             @default(0)
  completedAt  DateTime?
  updatedAt    DateTime        @default(now())

  @@unique([userId, bundleItemId], map: "uq_user_skill_item")
}

model SubtopicProfessionTag {
  id           String     @id @default(uuid())
  subtopicId   String
  subtopic     Subtopic   @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([subtopicId, professionId], map: "uq_subtopic_profession")
}

// ─── Decoupled Skill Building Models ──────────────────────────────────────────

model SkillTopic {
  id             String                   @id @default(uuid())
  professionId   String
  profession     Profession               @relation(fields: [professionId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  level          String? // e.g. "Beginner" / "Intermediate"
  durationWeeks  Decimal?                 @db.Decimal(4, 1)
  orderIndex     Int                      @default(0)
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  lessons        SkillLesson[]
  userProgresses UserSkillTopicProgress[]
}

model SkillLesson {
  id             String                    @id @default(uuid())
  skillTopicId   String
  skillTopic     SkillTopic                @relation(fields: [skillTopicId], references: [id], onDelete: Cascade)
  lessonId       String? // Reference to standard Learning Lesson if fetched
  lesson         Lesson?                   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  difficulty     Difficulty                @default(easy)
  orderIndex     Int                       @default(0)
  estimatedMins  Int?
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  userProgresses UserSkillLessonProgress[]
}

model SkillMcqSession {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    McqActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  topicId     String // skillTopicId context
  score       Int
  total       Int
  scorePct    Float?
  hintsUsed   Int              @default(0)
  completedAt DateTime         @default(now())
  answers     SkillMcqAnswer[]
}

model SkillMcqAnswer {
  id               String          @id @default(uuid())
  sessionId        String
  session          SkillMcqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         McqQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   McqOption       @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  isCorrect        Boolean
}

model SkillCanvasSession {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    CanvasActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  topicId     String // skillTopicId context
  score       Int?
  total       Int?
  scorePct    Float?
  canvasData  Json?
  hintsUsed   Int            @default(0)
  completedAt DateTime       @default(now())
}

model SkillQuantusSession {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activity      QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  topicId       String // skillTopicId context
  inputSnapshot Json
  score         Int             @default(0)
  total         Int             @default(0)
  scorePct      Float?
  hintsUsed     Int             @default(0)
  completedAt   DateTime        @default(now())
}

model UserSkillLessonProgress {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillLessonId       String
  skillLesson         SkillLesson  @relation(fields: [skillLessonId], references: [id], onDelete: Cascade)
  lessonCompletionPct Float        @default(0)
  mcqBestScore        Float?
  canvasBestScore     Float?
  quantusAttempted    Boolean      @default(false)
  status              LessonStatus @default(not_started)
  hintsUsed           Int          @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime     @default(now())

  @@unique([userId, skillLessonId], map: "uq_skill_ulp")
}

model UserSkillTopicProgress {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillTopicId     String
  skillTopic       SkillTopic @relation(fields: [skillTopicId], references: [id], onDelete: Cascade)
  lessonsCompleted Int        @default(0)
  lessonsTotal     Int        @default(0)
  completionPct    Float      @default(0)
  startedAt        DateTime?
  lastAccessedAt   DateTime?
  updatedAt        DateTime   @default(now())

  @@unique([userId, skillTopicId], map: "uq_user_skill_topic")
}

model UserStreak {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([userId, date], map: "uq_user_streak_date")
}
