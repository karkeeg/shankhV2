generator client {
  provider = "prisma-client-js"
}

generator client_root {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
//   theme    = "forest"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum ActivityType {
  mcq
  canvas
  quantus
}

enum CanvasSubtype {
  drag_drop
  freeform
}

enum AssemblyMode {
  sequence
  graph
}

enum ScoringMode {
  partial
  exact
}

enum CellType {
  editable
  formula
  prefilled
  empty
  header
}

enum CellStyle {
  default
  yellow
  blue
  bold
  gray
  green
}

enum Difficulty {
  easy
  medium
  hard
}

enum LessonStatus {
  not_started
  in_progress
  completed
}

enum TopicType {
  topic
  drill
}

enum SessionStatus {
  active
  completed
  abandoned
}

enum PlanTier {
  free
  pro
  enterprise
}

enum TestSessionStatus {
  in_progress
  completed
  expired
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNING — CONTENT HIERARCHY
// Module → Topic → Subtopic → Lesson → Activities
// ─────────────────────────────────────────────────────────────────────────────

model Module {
  id                   String               @id @default(uuid())
  slug                 String               @unique
  name                 String
  description          String?
  accentColor          String
  iconKey              String?
  orderIndex           Int                  @default(0)
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  topics               Topic[]
  userModuleProgresses UserModuleProgress[]
}

model Topic {
  id                  String              @id @default(uuid())
  moduleId            String
  module              Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name                String
  subtitle            String?
  description         String?
  tags                String[]            @default([])
  orderIndex          Int                 @default(0)
  type                TopicType           @default(topic)
  isActive            Boolean             @default(true)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  subtopics           Subtopic[]
  userTopicProgresses UserTopicProgress[]
}

model Subtopic {
  id                     String                  @id @default(uuid())
  topicId                String
  topic                  Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  type                   TopicType               @default(topic)
  thumbnailUrl           String?
  orderIndex             Int                     @default(0)
  isActive               Boolean                 @default(true)
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lessons                Lesson[]
  subtopicProfessionTags SubtopicProfessionTag[]
  userSubtopicProgresses UserSubtopicProgress[]
  userBookmarks          UserBookmark[]
}

model Lesson {
  id                   String               @id @default(uuid())
  subtopicId           String
  subtopic             Subtopic             @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  difficulty           Difficulty           @default(easy)
  orderIndex           Int                  @default(0)
  estimatedMins        Int?
  isActive             Boolean              @default(true)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lessonActivities     LessonActivity[]
  mcqActivity          McqActivity?
  canvasActivity       CanvasActivity?
  quantusActivity      QuantusActivity?
  userLessonProgresses UserLessonProgress[]
  userLessonSessions   UserLessonSession[]
  skillTestItems       SkillTestItem[]
  lessonReactions      LessonReaction[]
}

model LessonActivity {
  id           String       @id @default(uuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityType ActivityType
  orderIndex   Int          @default(0)

  @@unique([lessonId, activityType], map: "uq_lesson_act")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACTIVITIES
// ─────────────────────────────────────────────────────────────────────────────

model McqActivity {
  id           String           @id @default(uuid())
  lessonId     String           @unique
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String?
  instructions String
  context      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  questions    McqQuestion[]
  sessions     UserMcqSession[]
}

model McqQuestion {
  id           String          @id @default(uuid())
  activityId   String
  activity     McqActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionText String
  explanation  String
  orderIndex   Int             @default(0)
  createdAt    DateTime        @default(now())
  options      McqOption[]
  answers      UserMcqAnswer[]
}

model McqOption {
  id         String          @id @default(uuid())
  questionId String
  question   McqQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean         @default(false)
  orderIndex Int             @default(0)
  createdAt  DateTime        @default(now())
  answers    UserMcqAnswer[]

  @@index([questionId], map: "idx_mcq_options_question")
}

model QuantusActivity {
  id           String               @id @default(uuid())
  lessonId     String               @unique
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  context      String?
  referenceUrl String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  columnGroups QuantusColumnGroup[]
  columns      QuantusColumn[]
  quantusCells QuantusCell[]
  sessions     UserQuantusSession[]
}

model QuantusColumnGroup {
  id         String          @id @default(uuid())
  activityId String
  activity   QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  colStart   Int
  colEnd     Int
  bgColor    String          @default("#e8e8ff")
  textColor  String          @default("#333")
  orderIndex Int             @default(0)
}

model QuantusColumn {
  id         String          @id @default(uuid())
  activityId String
  activity   QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label      String
  colIndex   Int
  widthPx    Int             @default(100)

  @@unique([activityId, colIndex], map: "uq_quantus_col_index")
}

model QuantusCell {
  id            String          @id @default(uuid())
  activityId    String
  activity      QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  rowIndex      Int
  colIndex      Int
  cellType      String
  displayValue  String?
  expectedValue String?
  formula       String?
  formatType    String?
  isEditable    Boolean         @default(false)
  tolerancePct  Float?
  hintText      String?
  rowSpan       Int?            @default(1)
  colSpan       Int?            @default(1)

  @@unique([activityId, rowIndex, colIndex], map: "uq_quantus_cell")
}

// Canvas redesign — token-edge graph model
model CanvasActivity {
  id            String               @id @default(uuid())
  lessonId      String               @unique
  lesson        Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  instructions  String
  context       String?
  assemblyMode  AssemblyMode         @default(graph)
  scoringMode   ScoringMode          @default(partial)
  penaltyWeight Float                @default(0.5)
  passThreshold Float                @default(70)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tokens        CanvasToken[]
  solutionEdges CanvasSolutionEdge[]
  sessions      UserCanvasSession[]
}

model CanvasToken {
  id           String               @id @default(uuid())
  activityId   String
  activity     CanvasActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  displayText  String
  tokenRole    String
  shape        String               @default("rect")
  isDistractor Boolean              @default(false)
  orderIndex   Int                  @default(0)
  edgesFrom    CanvasSolutionEdge[] @relation("TokenEdgesFrom")
  edgesTo      CanvasSolutionEdge[] @relation("TokenEdgesTo")
}

model CanvasSolutionEdge {
  id            String         @id @default(uuid())
  activityId    String
  activity      CanvasActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fromTokenId   String
  fromToken     CanvasToken    @relation("TokenEdgesFrom", fields: [fromTokenId], references: [id], onDelete: Cascade)
  toTokenId     String
  toToken       CanvasToken    @relation("TokenEdgesTo", fields: [toTokenId], references: [id], onDelete: Cascade)
  operandSlot   String?
  isCommutative Boolean        @default(false)
  edgeRole      String
  edgeOrder     Int?
  edgeLabel     String?

  @@index([activityId], map: "idx_canvas_edge_activity")
}

model ActivityHint {
  id             String          @id @default(uuid())
  activityType   ActivityType
  activityId     String
  hintText       String
  orderIndex     Int
  createdAt      DateTime        @default(now())
  userHintUsages UserHintUsage[]

  @@unique([activityId, activityType, orderIndex], map: "uq_hint_order")
  @@index([activityId], map: "idx_activity_hint_activity")
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("learner")
  planType     PlanTier @default(free)
  avatarUrl    String?
  phone        String?
  timezone     String?

  // Onboarding profile
  username    String? @unique
  isOnboarded Boolean @default(false)
  profession  String?
  level       String?
  goal        String?
  firstTopic  String?

  createdAt  DateTime  @default(now())
  lastActive DateTime?
  deletedAt  DateTime?

  // Learning progress
  userLessonProgresses   UserLessonProgress[]
  userSubtopicProgresses UserSubtopicProgress[]
  userTopicProgresses    UserTopicProgress[]
  userModuleProgresses   UserModuleProgress[]

  // Learning sessions
  userLessonSessions UserLessonSession[]
  userActivityDrafts UserActivityDraft[]
  mcqSessions        UserMcqSession[]
  canvasSessions     UserCanvasSession[]
  quantusSessions    UserQuantusSession[]
  hintUsage          UserHintUsage[]

  // Skill building — tests
  skillTestSessions UserSkillTestSession[]

  // Streaks
  userStreaks UserStreak[]

  // Reactions
  lessonReactions LessonReaction[]

  // Bookmarks
  userBookmarks UserBookmark[]

  // Case simulations
  caseSessions UserCaseSession[]
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNING — PROGRESS
// ─────────────────────────────────────────────────────────────────────────────

model UserLessonProgress {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonCompletionPct Float        @default(0)
  mcqBestScore        Float?
  canvasBestScore     Float?
  quantusAttempted    Boolean      @default(false)
  status              LessonStatus @default(not_started)
  hintsUsed           Int          @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime     @default(now())

  @@unique([userId, lessonId], map: "uq_ulp")
}

model UserSubtopicProgress {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopicId            String
  subtopic              Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  subtopicCompletionPct Float    @default(0)
  recallStrength        Float    @default(0)
  conceptAccuracy       Float    @default(0)
  applicationScore      Float    @default(0)
  lessonsCompleted      Int      @default(0)
  lessonsTotal          Int      @default(0)
  updatedAt             DateTime @default(now())

  @@unique([userId, subtopicId], map: "uq_usp")
}

model UserTopicProgress {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicCompletionPct Float     @default(0)
  recallStrength     Float     @default(0)
  conceptAccuracy    Float     @default(0)
  applicationScore   Float     @default(0)
  lessonsCompleted   Int       @default(0)
  lessonsTotal       Int       @default(0)
  subtopicsCompleted Int       @default(0)
  subtopicsTotal     Int       @default(0)
  lastAccessedAt     DateTime?
  updatedAt          DateTime  @default(now())

  @@unique([userId, topicId], map: "uq_utp")
}

model UserModuleProgress {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId            String
  module              Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleCompletionPct Float    @default(0)
  recallStrength      Float    @default(0)
  conceptAccuracy     Float    @default(0)
  applicationScore    Float    @default(0)
  topicsStarted       Int      @default(0)
  topicsTotal         Int      @default(0)
  lessonsCompleted    Int      @default(0)
  lessonsTotal        Int      @default(0)
  updatedAt           DateTime @default(now())

  @@unique([userId, moduleId], map: "uq_ump")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNING — SESSIONS
// ─────────────────────────────────────────────────────────────────────────────

model UserLessonSession {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status              SessionStatus @default(active)
  currentActivityType ActivityType
  activityOrder       Json?
  lastActiveAt        DateTime      @default(now())
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  updatedAt           DateTime      @default(now())

  @@unique([userId, lessonId], map: "uq_user_lesson_session")
}

model UserActivityDraft {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activityType  ActivityType
  draftState    Json
  hintsRevealed Int          @default(0)
  startedAt     DateTime     @default(now())
  lastSavedAt   DateTime     @default(now())

  @@unique([userId, activityId, activityType], map: "uq_draft")
}

model UserMcqSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    McqActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  scorePct    Float?
  hintsUsed   Int             @default(0)
  completedAt DateTime        @default(now())
  answers     UserMcqAnswer[]

  // Link back from skill test responses
  skillTestResponses UserSkillTestResponse[]
}

model UserMcqAnswer {
  id               String         @id @default(uuid())
  sessionId        String
  session          UserMcqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         McqQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   McqOption      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  isCorrect        Boolean
}

model UserCanvasSession {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    CanvasActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  score       Int?
  total       Int?
  scorePct    Float?
  canvasData  Json?
  hintsUsed   Int            @default(0)
  completedAt DateTime       @default(now())

  skillTestResponses UserSkillTestResponse[]
}

model UserQuantusSession {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId    String
  activity      QuantusActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inputSnapshot Json
  score         Int             @default(0)
  total         Int             @default(0)
  scorePct      Float?
  hintsUsed     Int             @default(0)
  completedAt   DateTime        @default(now())

  skillTestResponses UserSkillTestResponse[]
}

model UserHintUsage {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintId     String
  hint       ActivityHint @relation(fields: [hintId], references: [id], onDelete: Cascade)
  revealedAt DateTime     @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// STREAKS
// ─────────────────────────────────────────────────────────────────────────────

model UserStreak {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  // @db.Date stores date only — no time component, prevents timezone duplicate rows
  createdAt DateTime @default(now())

  @@unique([userId, date], map: "uq_user_streak_date")
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKMARKS
// ─────────────────────────────────────────────────────────────────────────────

model UserBookmark {
  id         String   @id @default(uuid())
  userId     String
  subtopicId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@unique([userId, subtopicId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REACTIONS
// ─────────────────────────────────────────────────────────────────────────────

model LessonReaction {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  reaction  String // "like" | "dislike"
  source    String   @default("lesson") // "lesson" | "test"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, source])
}

// ─────────────────────────────────────────────────────────────────────────────
// SKILL BUILDING — PROFESSIONS
// ─────────────────────────────────────────────────────────────────────────────

model Profession {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String       @unique
  description String?
  iconKey     String?
  orderIndex  Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  skillTopics SkillTopic[]

  subtopicTags SubtopicProfessionTag[]
  skillTests   SkillTest[]
}

model SkillTopic {
  id           String     @id @default(uuid())
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(200)
  description  String?
  orderIndex   Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tests SkillTest[]

  @@index([professionId, orderIndex])
  @@map("skill_topics")
}

// Tags a subtopic to a profession.
// This is the source of truth for which activities belong to which profession.
// Admin uses this to populate the activity pool when creating a test.
model SubtopicProfessionTag {
  subtopicId   String
  subtopic     Subtopic   @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@id([subtopicId, professionId])
  @@index([professionId], map: "idx_spt_profession")
  @@index([subtopicId], map: "idx_spt_subtopic")
}

// ─────────────────────────────────────────────────────────────────────────────
// SKILL BUILDING — TESTS
// ─────────────────────────────────────────────────────────────────────────────

// A named test container belonging to one profession.
// Contains activities of any type (MCQ / Canvas / Quantus).
// On the frontend, tabs filter which activity type the user sees.
model SkillTest {
  id           String      @id @default(uuid())
  professionId String
  profession   Profession  @relation(fields: [professionId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        SkillTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  isPublished  Boolean     @default(false)
  name         String
  // e.g. "CA Foundation Set 1"
  description  String?
  isActive     Boolean     @default(true)
  orderIndex   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  typeConfigs SkillTestTypeConfig[]
  items       SkillTestItem[]
  sessions    UserSkillTestSession[]

  @@index([professionId, isActive], map: "idx_skill_test_profession")
}

// One row per activity type present in the test.
// Stores the admin-defined time limit for that activity type's session.
// e.g. MCQ session = 20 min, Canvas session = 30 min, Quantus session = 45 min
model SkillTestTypeConfig {
  id            String       @id @default(uuid())
  testId        String
  test          SkillTest    @relation(fields: [testId], references: [id], onDelete: Cascade)
  activityType  ActivityType
  timeLimitMins Int
  // Admin sets this when adding activities of that type to the test.

  @@unique([testId, activityType], map: "uq_test_type_config")
}

// Individual activities inside a test.
// activityId points to McqActivity.id / CanvasActivity.id / QuantusActivity.id
// (polymorphic — enforced at application level, not FK level)
//
// UNIQUENESS RULES:
//   uq_test_item_activity  — one activity can only ever be in ONE test globally
//   uq_test_item_unique    — one activity appears only once within a test
model SkillTestItem {
  id           String       @id @default(uuid())
  testId       String
  test         SkillTest    @relation(fields: [testId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id])
  activityType ActivityType
  activityId   String
  // Points to McqActivity / CanvasActivity / QuantusActivity
  // No FK here because Prisma doesn't support polymorphic FKs.
  // Application enforces referential integrity during creation.
  orderIndex   Int          @default(0)
  createdAt    DateTime     @default(now())

  responses UserSkillTestResponse[]

  @@unique([activityId, activityType], map: "uq_test_item_activity")
  @@unique([testId, activityId, activityType], map: "uq_test_item_unique")
  @@index([testId, activityType, orderIndex], map: "idx_test_items_type")
  @@index([activityId, activityType], map: "idx_test_item_lookup")
}

// ─────────────────────────────────────────────────────────────────────────────
// SKILL BUILDING — USER TEST SESSIONS & RESPONSES
// ─────────────────────────────────────────────────────────────────────────────

// One row per (user × test × activityType).
// Each activity type within a test is an INDEPENDENT session.
// @@unique enforces no retake at DB level — second insert rejected.
//
// TIMER MODEL:
//   timeLimitMins  — copied from SkillTestTypeConfig at session start
//   timeSpentSecs  — counts UP from 0; frontend sends updated value on pause + submit
//   Remaining time = (timeLimitMins × 60) - timeSpentSecs
//   Frontend enforces expiry: blocks input when remaining <= 0
//   No server-side cron needed.
//
// PAUSE / RESUME:
//   Frontend sends PATCH /skill/test-sessions/:id { timeSpentSecs } on pause.
//   On resume, frontend reads timeSpentSecs from session and continues countdown.
model UserSkillTestSession {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId       String
  test         SkillTest    @relation(fields: [testId], references: [id])
  activityType ActivityType

  // Timer
  timeLimitMins Int
  timeSpentSecs Int @default(0)

  // Progress
  totalItems     Int
  // Total items of this activityType in the test — set at session creation
  completedItems Int @default(0)

  // Score — null until session submitted
  scorePct Float?

  // State
  status TestSessionStatus @default(in_progress)

  startedAt    DateTime  @default(now())
  lastActiveAt DateTime?
  // Updated on every pause and resume
  completedAt  DateTime?
  // Set when status transitions to completed or expired

  responses UserSkillTestResponse[]

  // No retake — DB rejects a second session for same (user, test, activityType)
  @@unique([userId, testId, activityType], map: "uq_user_test_session")
  @@index([userId, lastActiveAt(sort: Desc)], map: "idx_session_recent")
  @@index([testId], map: "idx_session_test")
}

// One row per activity completed within a session.
// Links back to the existing session tables — no duplicate scoring data.
//
// existingSessionId references:
//   activityType = mcq     → UserMcqSession.id
//   activityType = canvas  → UserCanvasSession.id
//   activityType = quantus → UserQuantusSession.id
// The correct relation is activated based on activityType (app-level logic).
model UserSkillTestResponse {
  id           String               @id @default(uuid())
  sessionId    String
  session      UserSkillTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testItemId   String
  testItem     SkillTestItem        @relation(fields: [testItemId], references: [id])
  activityType ActivityType

  // Back-reference to the existing scoring session
  // Exactly one of these will be non-null depending on activityType
  mcqSessionId     String?
  mcqSession       UserMcqSession?     @relation(fields: [mcqSessionId], references: [id])
  canvasSessionId  String?
  canvasSession    UserCanvasSession?  @relation(fields: [canvasSessionId], references: [id])
  quantusSessionId String?
  quantusSession   UserQuantusSession? @relation(fields: [quantusSessionId], references: [id])

  scorePct    Float?
  submittedAt DateTime @default(now())

  @@unique([sessionId, testItemId], map: "uq_test_response")
  @@index([sessionId], map: "idx_test_response_session")
}

// =============================================================================
// CASE SIMULATIONS
// =============================================================================

// Reusable framework library — admin-defined, fixed consulting-style diagrams
// (Market Entry, Due Diligence, …) reused across case simulations.
// `structure` JSON shape:
//   nodes: [{ id, label, x, y, shape: "rectangle"|"ellipse"|"diamond", color, isBlank }]
//   edges: [{ id, sourceId, targetId }]
// isBlank=false → locked node, label shown to learner.
// isBlank=true  → blank input node, label is the EXPECTED value (hidden from learner, used for grading).
model Framework {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  structure   Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CaseSimulation {
  id          String     @id @default(uuid())
  title       String
  description String?
  difficulty  Difficulty @default(medium)
  isPublished Boolean    @default(false)
  orderIndex  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caseStudies    CaseStudy[]
  caseActivities CaseActivity[]
  caseSessions   UserCaseSession[]
}

model CaseStudy {
  id               String         @id @default(uuid())
  caseSimulationId String
  caseSimulation   CaseSimulation @relation(fields: [caseSimulationId], references: [id], onDelete: Cascade)
  title            String
  content          String
  orderIndex       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Activities inside a case simulation ? manually authored by admin (no lesson link)
// activityData JSON shape:
//   MCQ:     { instructions, context, questions: [{ id, questionText, explanation, options: [{ id, optionText, isCorrect }] }] }
//   Canvas:  { instructions, context, title, assemblyMode, scoringMode, tokens, draggableElements,
//             recommendationEnabled?: bool, recommendationPrompt?: string }  // optional post-canvas text recommendation
//   Quantus: { instructions, context, title, gridRows, gridCols, gridValues, correctAnswers }
model CaseActivity {
  id               String         @id @default(uuid())
  caseSimulationId String
  caseSimulation   CaseSimulation @relation(fields: [caseSimulationId], references: [id], onDelete: Cascade)
  activityType     ActivityType
  activityData     Json
  orderIndex       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  responses CaseActivityResponse[]
}

model UserCaseSession {
  id               String    @id @default(uuid())
  userId           String
  caseSimulationId String
  status           String    @default("reading") // "reading" | "testing" | "completed"
  studiesRead      Boolean   @default(false)
  totalActivities  Int       @default(0)
  completedCount   Int       @default(0)
  score            Float?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseSimulation CaseSimulation         @relation(fields: [caseSimulationId], references: [id], onDelete: Cascade)
  responses      CaseActivityResponse[]

  @@unique([userId, caseSimulationId])
}

model CaseActivityResponse {
  id                 String          @id @default(uuid())
  sessionId          String
  session            UserCaseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  caseActivityId     String
  activity           CaseActivity    @relation(fields: [caseActivityId], references: [id], onDelete: Cascade)
  responseData       Json
  // Free-text recommendation the learner writes after completing the activity
  // (e.g. their strategic conclusion on a canvas/framework). Qualitative — not
  // auto-graded. Optional: only canvas activities with a recommendation prompt use it.
  recommendationText String?
  scorePct           Float?
  isDraft            Boolean         @default(false) // true = saved-in-progress (not graded, not counted complete)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@unique([sessionId, caseActivityId])
}
